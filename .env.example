DOCPIPE_INGESTION_SERVICE_NAME=DocPipe Ingestion
DOCPIPE_INGESTION_ENVIRONMENT=local
DOCPIPE_INGESTION_DATABASE_URL=sqlite:///dataset/docpipe-ingestion.db
DOCPIPE_INGESTION_SQLITE_TIMEOUT_SECONDS=5
DOCPIPE_INGESTION_SQLITE_WAL_ENABLED=true
DOCPIPE_INGESTION_STORAGE_ROOT=dataset/documents
DOCPIPE_INGESTION_MAX_FILE_SIZE_BYTES=10485760
DOCPIPE_INGESTION_STORAGE_CHUNK_SIZE_BYTES=65536
DOCPIPE_INGESTION_INCOMPLETE_FILE_AGE_SECONDS=3600
RABBITMQ_HOSTNAME=docpipe-rabbitmq
RABBITMQ_USER=docpipe
RABBITMQ_PASSWORD=docpipe
RABBITMQ_VHOST=docpipe
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
DOCPIPE_INGESTION_RABBITMQ_URL=amqp://docpipe:docpipe@localhost:5672/docpipe
DOCPIPE_INGESTION_RABBITMQ_EXCHANGE=docpipe.events
DOCPIPE_INGESTION_RABBITMQ_QUEUE=docpipe.document.received.v1
DOCPIPE_INGESTION_RABBITMQ_ROUTING_KEY=document.received.v1
DOCPIPE_INGESTION_RABBITMQ_TIMEOUT_SECONDS=5
DOCPIPE_INGESTION_OUTBOX_MAX_ATTEMPTS=5
DOCPIPE_INGESTION_OUTBOX_BACKOFF_SECONDS=1
DOCPIPE_INGESTION_OUTBOX_BATCH_SIZE=50
DOCPIPE_INGESTION_OUTBOX_POLLING_SECONDS=1
