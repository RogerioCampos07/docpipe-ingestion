DOCPIPE_INGESTION_WORKER_METRICS_HOST=127.0.0.1
DOCPIPE_INGESTION_WORKER_METRICS_PORT=9001
DOCPIPE_INGESTION_TRACES_ENABLED=false
DOCPIPE_INGESTION_TRACES_EXPORTER=none
