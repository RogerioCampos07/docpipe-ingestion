DOCPIPE_INGESTION_BLOB_READ_TIMEOUT_SECONDS=10
DOCPIPE_INGESTION_BLOB_OPERATION_TIMEOUT_SECONDS=30
DOCPIPE_INGESTION_BLOB_RETRY_TOTAL=2
DOCPIPE_INGESTION_BLOB_BLOCK_SIZE_BYTES=1048576
DOCPIPE_INGESTION_MAX_FILE_SIZE_BYTES=10485760
DOCPIPE_INGESTION_STORAGE_CHUNK_SIZE_BYTES=65536
DOCPIPE_INGESTION_INCOMPLETE_FILE_AGE_SECONDS=3600
RABBITMQ_HOSTNAME=docpipe-rabbitmq
RABBITMQ_USER=docpipe
RABBITMQ_PASSWORD=docpipe
RABBITMQ_VHOST=docpipe
