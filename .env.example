RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_DB=docpipe_ingestion
POSTGRES_USER=docpipe
POSTGRES_PASSWORD=docpipe-local
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
