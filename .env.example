DOCPIPE_INGESTION_POSTGRES_LOCK_TIMEOUT_MS=3000
DOCPIPE_INGESTION_STORAGE_BACKEND=local
DOCPIPE_INGESTION_STORAGE_ROOT=dataset/documents
