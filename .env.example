DOCPIPE_INGESTION_SERVICE_NAME=DocPipe Ingestion
DOCPIPE_INGESTION_ENVIRONMENT=local
DOCPIPE_INGESTION_DATABASE_URL=sqlite:///dataset/docpipe-ingestion.db
DOCPIPE_INGESTION_SQLITE_TIMEOUT_SECONDS=5
DOCPIPE_INGESTION_SQLITE_WAL_ENABLED=true
DOCPIPE_INGESTION_STORAGE_ROOT=dataset/documents
DOCPIPE_INGESTION_MAX_FILE_SIZE_BYTES=10485760
DOCPIPE_INGESTION_STORAGE_CHUNK_SIZE_BYTES=65536
DOCPIPE_INGESTION_INCOMPLETE_FILE_AGE_SECONDS=3600
