DOCPIPE_INGESTION_OUTBOX_MAX_ATTEMPTS=5
DOCPIPE_INGESTION_OUTBOX_BACKOFF_SECONDS=1
DOCPIPE_INGESTION_OUTBOX_BATCH_SIZE=50
DOCPIPE_INGESTION_OUTBOX_POLLING_SECONDS=1
DOCPIPE_INGESTION_LOG_FORMAT=json
DOCPIPE_INGESTION_LOG_LEVEL=INFO
DOCPIPE_INGESTION_METRICS_ENABLED=true
