  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP requests / second", "targets": [{"expr": "sum by (route) (rate(docpipe_ingestion_http_requests_total[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "HTTP p95 latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route) (rate(docpipe_ingestion_http_request_duration_seconds_bucket[5m])))"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Uploads", "targets": [{"expr": "sum by (outcome) (rate(docpipe_ingestion_uploads_total[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}},
    {"id": 4, "type": "timeseries", "title": "Request bytes / second", "targets": [{"expr": "sum(rate(docpipe_ingestion_http_request_body_bytes_total[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}},
    {"id": 5, "type": "timeseries", "title": "Errors by category", "targets": [{"expr": "sum by (error_category) (rate(docpipe_ingestion_http_errors_total[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}},
    {"id": 6, "type": "timeseries", "title": "Database duration", "targets": [{"expr": "sum by (backend, operation) (rate(docpipe_ingestion_database_operation_duration_seconds_sum[5m])) / sum by (backend, operation) (rate(docpipe_ingestion_database_operation_duration_seconds_count[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}},
    {"id": 7, "type": "timeseries", "title": "Storage duration", "targets": [{"expr": "sum by (backend) (rate(docpipe_ingestion_storage_upload_duration_seconds_sum[5m])) / sum by (backend) (rate(docpipe_ingestion_storage_upload_duration_seconds_count[5m]))"}], "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}},
    {"id": 8, "type": "stat", "title": "Pending outbox events", "targets": [{"expr": "max(docpipe_ingestion_outbox_pending_events)"}], "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}},
    {"id": 9, "type": "stat", "title": "Oldest pending event age", "targets": [{"expr": "max(docpipe_ingestion_outbox_oldest_pending_age_seconds)"}], "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}},
